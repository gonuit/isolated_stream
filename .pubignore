# Mirrors the root .gitignore (pub uses .pubignore when present).
.dart_tool/
pubspec.lock
coverage/

# Compiled test workers (tool/test_web.sh).
test/web/worker.js*
test/web/worker.wasm*
test/web/worker.mjs
test/web/worker.support.js
test/web/*.deps

# Private local notes
.local/

# Build outputs and IDE metadata left beside the example.
build/
.idea/
.vscode/
